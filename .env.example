# llmstxt-social Environment Configuration
# Copy this file to .env and fill in your actual values

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://postgres:dev_password@postgres/llmstxt
POSTGRES_PASSWORD=dev_password

# ===== Redis =====
REDIS_URL=redis://redis:6379

# ===== API Keys =====
# Required: Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ===== LLM provider (Open Org generation + strategy/idea creator) =====
# Swap the model/backend without code changes. Provider is one of:
#   anthropic  — native SDK (prompt caching + tool use); uses ANTHROPIC_API_KEY
#   openrouter — OpenAI-compatible; uses OPENROUTER_API_KEY
#   ollama     — Ollama Cloud (OpenAI-compatible); uses OLLAMA_API_KEY
LLM_PROVIDER=anthropic
# Override the provider's default model. Use the provider's own model id, e.g.
# claude-sonnet-4-6 (anthropic), anthropic/claude-3.5-sonnet (openrouter),
# gpt-oss:120b (ollama). Leave blank to use the built-in default.
LLM_MODEL=
# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# Required for paid tier: Get from https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
STRIPE_PUBLIC_KEY=pk_test_your-public-key-here
VITE_STRIPE_PUBLIC_KEY=pk_test_your-public-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# One-time payments kill switch. false (default) = full pipeline (enrichment
# + assessment) is free and one-time payment endpoints return 403. Monitoring
# subscriptions stay paid via Stripe regardless. Keep PAYMENTS_ENABLED and
# VITE_PAYMENTS_ENABLED in sync — the second is baked into the web build.
PAYMENTS_ENABLED=false
VITE_PAYMENTS_ENABLED=false

# Optional: Get from https://resend.com/ (for email notifications)
RESEND_API_KEY=re_your-resend-key-here

# Optional: Get from https://www.gov.uk/guidance/charity-commission-data-api
CHARITY_COMMISSION_API_KEY=your-charity-commission-key-here

# ===== Application Settings =====
SECRET_KEY=change-this-to-a-random-secret-in-production
ENVIRONMENT=development
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
WEB_DIST_DIR=/app/web/dist

# Auth cookie scope. Leave UNSET in development so the cookie is host-only on
# localhost. In production set to a leading-dot domain that covers every
# subdomain you want a single login to span (e.g. ``.good-ship.co.uk`` lets
# the same login work on both llmstxt.social and openorg.good-ship.co.uk).
# AUTH_COOKIE_DOMAIN=.good-ship.co.uk

# Origins allowed to set the magic-link base URL. One FastAPI process serves
# multiple hostnames, so the login link host is taken from the request Origin
# when it matches this exact-string allowlist; anything else falls back to
# FRONTEND_URL. Never reflect an unvalidated Origin into a login link.
# MAGIC_LINK_ORIGIN_ALLOWLIST=https://llmstxt.social,https://openorg.good-ship.co.uk
# From-address for Open Org login emails (must be on a Resend-verified domain).
# OPENORG_FROM_EMAIL=Open Org <hello@openorg.good-ship.co.uk>

# ===== Open Org / Murmurations =====
# Defaults point at the Murmurations *test* index until our
# open_org_profile-v0.1.0 schema PR is merged upstream. Flip these to
# production once the schema is live in the production library:
#   https://index.murmurations.network/v2
#   https://library.murmurations.network/v2
MURMURATIONS_INDEX_URL=https://test-index.murmurations.network/v2
MURMURATIONS_LIBRARY_URL=https://test-library.murmurations.network/v2

# Rate limiting (requests per day for free tier)
FREE_TIER_DAILY_LIMIT=10

# CORS origins (comma-separated, for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://llmstxt.social,https://openorg.good-ship.co.uk

# ===== Optional: Email Settings =====
# If not using Resend, configure SMTP directly
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ===== Phase 2: Evidence Enrichers =====
# Companies House API (governance data: officers, filing history, PSC)
# Get from https://developer-specs.company-information.service.gov.uk/
# COMPANIES_HOUSE_API_KEY=your-companies-house-key

# 360Giving API v1 (grant data — no auth required, 2 req/sec rate limit)
# No env var needed, the enricher queries api.threesixtygiving.org directly.

# ===== Phase 2: CRM Integrations =====
# Beacon CRM (https://beaconcrm.com/api)
# BEACON_API_KEY=your-beacon-api-key

# Lamplight CRM (https://lamplight.online/api — paid modules required)
# LAMPLIGHT_API_KEY=your-lamplight-api-key
# LAMPLIGHT_BASE_URL=https://lamplight.online/api

# Salesforce Nonprofit Cloud
# SALESFORCE_ACCESS_TOKEN=your-salesforce-access-token
# SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com

# ===== Phase 2: MCP Server =====
# Transport: stdio (local, for Claude Desktop/CLI) or streamable-http (remote)
# MCP_TRANSPORT=stdio
# MCP_HTTP_PORT=8001

# ===== Phase 2: Hypercerts =====
# Ethereum wallet private key for custodial minting (Good Ship custodial wallet).
# Orgs don't need their own wallet in Phase 2 — Phase 3 transitions to org-owned.
# HYPERCERTS_WALLET_PRIVATE_KEY=your-wallet-private-key
# HYPERCERTS_CONTRACT_ADDRESS=0x...  # Optimism mainnet Hypercerts contract
# HYPERCERTS_CHAIN_ID=10  # Optimism mainnet
